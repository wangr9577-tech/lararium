# Kruskal 代码仓库忽略清单

# 依赖与构建产物
node_modules/
dist/
frontend/dist/
frontend/node_modules/

# Python 环境与缓存
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 本地运行、临时与自动化脚本
runtime/
scripts/
*.bat
*.ps1
*.vbs
strata-restart.sh

# 智能体与调试临时目录
.agent-teams/
.dsh_processing/
.acl-recovery/
.e2e-shots/
kruskal_*_test_*
frontend/pnpm-lock.yaml
frontend/pnpm-workspace.yaml

# 数据、密钥与运行产物（包含用户全部个人数据、密码包裹与加密库，绝不上云）
data/
backend/data/
backend/.autokey
*.enc
*.key
*.kek*
initial_password.txt
*.log
backend/*.log
backend/server.log
backups/
nohup.out
*.db
*.sqlite
*.sqlite3

# 本地私有配置文件（存放私有 API Key、模型端点、密码与个性化设置，绝对不入 Git）
local_settings.json
config.local.json
*.local.json
*.local.env
.env
.env.local
.env.*.local
