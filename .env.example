# ==========================================
# Kruskal 运行与部署环境配置示例
# ==========================================

# 监听地址与端口（默认仅绑定 127.0.0.1，校外通过 SSH/Cloudflare 隧道访问）
KRUSKAL_HOST=127.0.0.1
KRUSKAL_PORT=18080

# 数据与密钥目录（默认落盘在 backend/data）
KRUSKAL_DATA_DIR=backend/data

# 项目外部文档源挂载根目录（只允许挂载该目录下的 Markdown 项目，防止越权访问）
KRUSKAL_CODE_ROOT=~/workspace

# 免密自动解锁宿主机私钥存放路径（不在数据备份包内，严格 0600 权限）
KRUSKAL_AUTOKEY=backend/.autokey

# 安全与调试开关
# KRUSKAL_DEV=0  # 设为 1 开启热更新并暴露 /docs Swagger API 文档；生产环境保持 0
# KRUSKAL_CSP=1  # 设为 0 可临时关闭内容安全策略 Content-Security-Policy 响应头

# 备份与还原口令（用于 deploy/backup.sh 对称加密 SQLite 快照）
KRUSKAL_BACKUP_PW=your_backup_encryption_passphrase_here

# 本地/云端 AI 模型服务配置（可选，完全兼容 OpenAI 接口规范，如 vLLM / Ollama）
KRUSKAL_AI_ENABLED=1
KRUSKAL_AI_PROVIDER=openai
KRUSKAL_AI_ENDPOINT=http://127.0.0.1:8000/v1
KRUSKAL_AI_MODEL=qwen2.5-7b-instruct
KRUSKAL_AI_API_KEY=unused
KRUSKAL_AI_TIMEOUT=60
